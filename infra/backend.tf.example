# Copy to backend.tf and fill in your own bucket to keep state remotely.
# The state contains the generated JWT secret, so the bucket must be private and encrypted.
terraform {
  backend "s3" {
    bucket       = "YOUR-TF-STATE-BUCKET"
    key          = "ecs-microservices/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true # S3-native locking (Terraform >= 1.10); older versions need a DynamoDB lock table
  }
}
